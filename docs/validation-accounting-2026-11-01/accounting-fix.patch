+            }
+        }
+        else if (Status == SQLITE_DONE) Status = SQLITE_CORRUPT;
+    }
+    int FinalStatus = sqlite3_finalize(Accounting);
+    if (Status == SQLITE_OK) Status = FinalStatus;
+    if (Status != SQLITE_OK) return Status;
+
